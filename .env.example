# =============================================================================
# Collabora Standalone - Environment Configuration
# =============================================================================
# Copy this file to .env and customize for your environment
# For development: Use defaults below
# For production: Generate secure secrets with: openssl rand -hex 32

# -----------------------------------------------------------------------------
# Domain Configuration
# -----------------------------------------------------------------------------
DOMAIN=localhost

# -----------------------------------------------------------------------------
# Collabora Admin Console (/browser/dist/admin/admin.html)
# -----------------------------------------------------------------------------
COLLABORA_ADMIN_USER=admin
# SECURITY: Generate with: openssl rand -base64 12
COLLABORA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD

# -----------------------------------------------------------------------------
# Security Secrets (REQUIRED - Generate before deployment!)
# -----------------------------------------------------------------------------
# SECURITY: Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
WOPI_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# -----------------------------------------------------------------------------
# PostgreSQL Database
# -----------------------------------------------------------------------------
POSTGRES_USER=collabora
# SECURITY: Generate with: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_SECURE_PASSWORD
POSTGRES_DB=collabora_db

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
LOG_TO_FILE=false

# Storage limits
MAX_UPLOAD_SIZE=100
STORAGE_QUOTA_PER_USER=5368709120

# Session timeout (seconds)
SESSION_TIMEOUT=86400

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900

# -----------------------------------------------------------------------------
# Branding & Customization (Frontend)
# -----------------------------------------------------------------------------
# Application name displayed throughout the UI
VITE_APP_NAME=Collabora Docs

# Tagline shown on login page
VITE_APP_TAGLINE=Your documents, anywhere

# Custom logo URL (place file in web-frontend/public/custom/)
# Example: /custom/my-logo.png
VITE_LOGO_URL=

# Welcome banner settings
VITE_SHOW_WELCOME_BANNER=true
VITE_WELCOME_TITLE=Welcome to {appName}
VITE_WELCOME_MESSAGE=Start creating and editing documents right away.

# Login/Register page customization
VITE_LOGIN_TITLE=Sign in to your account
VITE_REGISTER_TITLE=Create your account
VITE_ALLOW_REGISTRATION=true

# Footer
VITE_SHOW_FOOTER=true
VITE_FOOTER_TEXT=© {year} {appName}. All rights reserved.
